# Blockscout Pro API key.
# Required for Blockscout metadata and ABI requests.
BLOCKSCOUT_API_KEY=

# Arc Mainnet RPC endpoint.
# Optional. Falls back to the official public Arc Mainnet RPC.
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# Blockscout API base URL for Arc Mainnet.
# Optional. Falls back to the default Arc Mainnet Blockscout API.
BLOCKSCOUT_BASE_URL=https://api.blockscout.com/5042/api/v2

# Sourcify API base URL.
# Optional. Used as ABI/evidence fallback when Blockscout is unavailable
# or does not provide usable ABI evidence.
SOURCIFY_BASE_URL=https://sourcify.dev/server/v2
